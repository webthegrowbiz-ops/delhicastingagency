{
  "name": "delhi-casting-agency-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Delhi Casting Agency (Way To Bollywood) — Fullstack Platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend start",
    "dev": "npm --prefix frontend dev",
    "build:frontend": "npm --prefix frontend run build",
    "start:frontend": "npm --prefix frontend start",
    "build:backend": "npm --prefix backend run build",
    "start:backend": "npm --prefix backend start",
    "postinstall": "npm --prefix backend run postinstall"
  }
}
