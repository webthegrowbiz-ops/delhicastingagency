PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/dca_db
JWT_SECRET=your_jwt_secret_here
MFA_ENCRYPTION_KEY=your_32_byte_hex_encryption_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_MERCHANT_SALT=your_payu_merchant_salt

# Email Service Configuration (Resend or Gmail / SMTP)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="Delhi Casting Agency" <your_email@gmail.com>

# Alternative: Resend Transactional Email Service
RESEND_API_KEY=re_your_resend_api_key_here

